// Copy this into Firebase Console → Firestore Database → Rules, and Publish.
//
// This app never reads/writes Firestore from the browser -- every read and
// write goes through app/api/pricing/route.js on the server, using the
// Admin SDK (lib/firebaseAdmin.js), which bypasses these rules entirely.
// These rules exist purely as a safety net: if a client SDK were ever
// pointed at this project directly, it would see and change nothing.

rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
